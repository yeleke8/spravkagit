<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Сурет -->
        <ImageView
            android:id="@+id/imgDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Атауы -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Заведение аты"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <!-- Рейтинг және Мекенжай -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.5"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDetailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Мекенжайы"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

            <!-- КНОПКИ ДЕЙСТВИЙ (Звонок, Insta, WA) -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Қоңырау"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#10B981"/>

                <Button
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:layout_marginHorizontal="4dp"
                    android:backgroundTint="#25D366"/>

                <Button
                    android:id="@+id/btnInstagram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Insta"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#E1306C"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Ақпарат блогы (Чек, Кухня) -->
            <LinearLayout
                android:id="@+id/layoutAttributes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Программно толтырылады -->
            </LinearLayout>

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginVertical="12dp"/>

            <!-- Жұмыс уақыты -->
            <TextView
                android:text="Жұмыс уақыты"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1F2937"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvWorkTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#4B5563"
                android:text="Күн сайын: 09:00 - 21:00"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginVertical="12dp"/>

            <!-- Ыңғайлылықтар (Tags) -->
            <TextView
                android:text="Ерекшеліктері"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1F2937"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <!-- Chips added programmatically -->
            </com.google.android.material.chip.ChipGroup>

            <!-- Fallback container если ChipGroup жоқ болса -->
            <LinearLayout
                android:id="@+id/layoutTagsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginVertical="12dp"/>

            <!-- Сипаттамасы -->
            <TextView
                android:text="Сипаттама"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1F2937"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Сипаттама мәтіні..."
                android:textSize="15sp"
                android:textColor="#374151"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>