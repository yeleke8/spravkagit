<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <!-- ЖОҒАРҒЫ БӨЛІК: ҚОСУ ЖӘНЕ СТАТУС -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Статус: Өшіп тұр"
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_power"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#03DAC5"
            android:contentDescription="Connect"/>
    </LinearLayout>

    <!-- ДЫБЫСТЫ ӨШІРУ БАТЫРМАСЫ -->
    <Button
        android:id="@+id/btnMuteAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ДАБЫЛДЫ ӨШІРУ 🔇"
        android:backgroundTint="#CF6679"
        android:textColor="#000000"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        tools:visibility="visible"/>

    <!-- НЕГІЗГІ ТІЗІМ (SCROLLVIEW) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnMuteAlert"
        app:layout_constraintBottom_toTopOf="@id/btnHistory">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?android:dividerHorizontal"
            android:showDividers="middle">

            <!-- 1. ЖЫЛДАМДЫҚ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Жылдамдық"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 км/сағ"
                    android:textColor="#03DAC5"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 2. АЙНАЛЫМ (RPM) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Айналым (RPM)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvRpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#03DAC5"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 3. ТЕМПЕРАТУРА (COOLANT) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Антифриз Темп."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 °C"
                    android:textColor="#03DAC5"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 4. ВОЛЬТАЖ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Вольтаж"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvVolt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- V"
                    android:textColor="#FFB74D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 5. ҚОЗҒАЛТҚЫШ ЖҮКТЕМЕСІ (LOAD) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Жүктеме (Load)"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvLoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 %"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 6. ДРОССЕЛЬ ОРНЫ (THROTTLE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Дроссель"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvThrottle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 %"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 7. КІРЕТІН АУА ТЕМПЕРАТУРАСЫ (INTAKE TEMP) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Кіретін Ауа T."
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvIntakeTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 °C"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 8. АУА АҒЫНЫ (MAF) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ауа ағыны (MAF)"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvMaf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 г/с"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 9. ЖАНАРМАЙ ДЕҢГЕЙІ (FUEL LEVEL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Жанармай"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvFuelLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 10. АТМОСФЕРАЛЫҚ ҚЫСЫМ (BAROMETRIC) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Атм. Қысым"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvBarometric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 кПа"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 11. СЫРТҚЫ АУА ТЕМПЕРАТУРАСЫ (AMBIENT) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Сыртқы Ауа T."
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvAmbientTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 °C"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- 12. ОТАЛУ БҰРЫШЫ (TIMING ADVANCE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Оталу Бұрышы"
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tvTiming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 °"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ТАРИХ БАТЫРМАСЫ -->
    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="САПАРЛАР ТАРИХЫ"
        android:backgroundTint="#3700B3"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>